# Copy to .env and fill in.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004   # falls back to gemini-embedding-001 if unavailable
EMBEDDING_DIM=768

POSTGRES_HOST=your-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_SSLMODE=require        # set to "disable" for a local Postgres
POSTGRES_SCHEMA=sensiwise

PORT=3001
